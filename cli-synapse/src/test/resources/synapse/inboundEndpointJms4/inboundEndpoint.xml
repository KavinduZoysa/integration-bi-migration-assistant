<?xml version="1.0" encoding="UTF-8"?>
<inboundEndpoint xmlns="http://ws.apache.org/ns/synapse"
                 name="JMSInboundEndpoint"
                 sequence="JMSInjectingSeq"
                 onError="JMSErrorSeq"
                 protocol="jms"
                 suspend="false">
    <parameters>
        <!-- Polling interval in milliseconds -->
        <parameter name="interval">1000</parameter>
        <parameter name="sequential">true</parameter>
        <parameter name="coordination">true</parameter>

        <!-- JNDI settings — update to match your JMS provider (e.g. ActiveMQ) -->
        <parameter name="java.naming.factory.initial">org.apache.activemq.jndi.ActiveMQInitialContextFactory</parameter>
        <parameter name="java.naming.provider.url">tcp://localhost:61616</parameter>

        <!-- Connection factory and destination -->
        <parameter name="transport.jms.ConnectionFactoryJNDIName">QueueConnectionFactory</parameter>
        <parameter name="transport.jms.ConnectionFactoryType">queue</parameter>
        <parameter name="transport.jms.Destination">TestQueue</parameter>

        <!-- Session settings -->
        <parameter name="transport.jms.SessionTransacted">false</parameter>
        <parameter name="transport.jms.SessionAcknowledgement">AUTO_ACKNOWLEDGE</parameter>

        <!-- Content type of incoming JMS messages -->
        <parameter name="transport.jms.ContentType">application/json</parameter>
    </parameters>
</inboundEndpoint>
