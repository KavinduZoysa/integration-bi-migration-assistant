<?xml version="1.0" encoding="UTF-8"?>
<api context="/NamedFaultSequencePrecedence1" name="NamedFaultSequencePrecedence1"
     xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="GET" uri-template="/status" faultSequence="myFault">
        <inSequence>
            <payloadFactory media-type="json" template-type="default">
                <format>{"Hello":"World"}</format>
            </payloadFactory>
            <respond/>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json" template-type="default">
                <format>{"error":"inline, should be ignored"}</format>
            </payloadFactory>
            <respond/>
        </faultSequence>
    </resource>
</api>
